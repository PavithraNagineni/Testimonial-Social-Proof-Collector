# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/testimonial_collector

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (verification / reset simulation)
# When no real SMTP is configured, the server logs email content to the console
# and (in development) returns the raw token in the API response so you can test flows.
EMAIL_FROM="Testimonial Collector <no-reply@testimonials.local>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
